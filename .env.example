ORDEAL_ENV=production
ORDEAL_AUTH_DISABLED=false
ORDEAL_CORS_ORIGINS=https://ordeal.example.com
ORDEAL_PUBLIC_BASE_URL=https://api.ordeal.example.com
ORDEAL_TOOL_PROXY_BASE_URL=https://api.ordeal.example.com
DATABASE_URL=postgresql+psycopg://ordeal:CHANGE_ME@postgres:5432/ordeal
ORDEAL_MAX_PARALLEL_TRIALS=128
ORDEAL_MAX_FUZZ_ITERATIONS=5000
ORDEAL_JOB_LEASE_SECONDS=180
ORDEAL_RETENTION_DAYS=30
# Optional OpenAI-compatible model endpoint used by learned/generative simulation.
# This may be a managed API or any separately operated inference service.
ORDEAL_SIMULATOR_ENDPOINT=http://model-endpoint:8000/v1
ORDEAL_SIMULATOR_MODEL=Qwen/Qwen3-32B
ORDEAL_SIMULATOR_API_KEY=

# Apache Kafka execution data plane
ORDEAL_QUEUE_BACKEND=kafka
ORDEAL_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ORDEAL_KAFKA_TOPIC_PREFIX=ordeal
ORDEAL_KAFKA_CONSUMER_GROUP_PREFIX=ordeal
ORDEAL_KAFKA_COMPRESSION=lz4
ORDEAL_KAFKA_LINGER_MS=5
ORDEAL_KAFKA_MAX_BATCH_BYTES=1048576
ORDEAL_KAFKA_OUTBOX_BATCH=500
# For TLS/SASL clusters, set as appropriate:
# ORDEAL_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# ORDEAL_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# ORDEAL_KAFKA_SASL_USERNAME=
# ORDEAL_KAFKA_SASL_PASSWORD=
