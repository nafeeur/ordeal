pipeline {
  agent any
  stages {
    stage('Agent behavior') {
      steps {
        sh 'python3 -m venv .venv'
        sh ".venv/bin/pip install '.[server]'"
        sh '.venv/bin/ordeal-behavior run examples/enterprise/suite.py --json report.json --junit report.xml'
        sh '.venv/bin/ordeal-server gate report.json --summary summary.md'
      }
      post { always { junit 'report.xml'; archiveArtifacts artifacts: 'report.json,summary.md', allowEmptyArchive: true } }
    }
  }
}
