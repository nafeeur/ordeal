{
  "schema": "ordeal.pack/v1",
  "name": "IT access controls",
  "version": "1.0.0",
  "resources": [
    {
      "kind": "evaluator",
      "name": "Approve before grant",
      "data": {
        "type": "tool_order",
        "before": "approve_access",
        "after": "grant_access"
